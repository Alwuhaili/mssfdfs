{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "../server/provisionHttp.ts",
    "../server/accountProvisioningFirebase.ts",
    "../server/accountProvisioningCore.ts",
    "../src/utils/newAccountPolicy.ts"
  ]
}
