# .env.example
# All services operate with self-contained defaults and sandbox fallbacks.

# Security Hardening V1
NODE_ENV=production
# 32+ random bytes; server-only. Never prefix with VITE_.
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SERVER_SECRET
# Destructive reset remains disabled unless intentionally enabled temporarily.
ALLOW_DATABASE_RESET=false
# Firebase Authentication migration / strict mode
VITE_ALLOW_LEGACY_AUTH=false
ADMIN_EMAIL=principal@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_12_CHARS_MINIMUM
ADMIN_USERNAME=admin_maysan
ADMIN_PHONE=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_DATABASE_ID=ai-studio-maysansecondarys-86fbb526-029b-4543-9539-440c4258ecaf
# Optional but strongly recommended after creating a reCAPTCHA Enterprise key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Keep false in production. Client-side API/webhook secrets are unsafe.
VITE_ALLOW_CLIENT_SIDE_INTEGRATION_SECRETS=false
# Optional legacy Express data store. Point this to a private persistent volume, not the web source tree.
SCHOOL_DATA_DIR=/var/lib/maysan-school
